# config: Borg config options other than cheat death. Each run rewrites
# one option of the stock borg.txt (harness/run.sh config flags) and uses
# the birth menu's real letters (flag "menu") and Borg cheat death.
# The six runs are the ones the second external review (REVIEW-821cad310)
# ran by hand: munchkin start and lunal mode, each with the same three
# characters. Blackguard munchkin is slow (about 137k keys by turn 20k),
# so its runs stop at 20k game turns.
# NAME                    SEED   RACE CLASS TURNS   FLAGS
# borg_munchkin_start = TRUE
cfg-munchkin-human-war    42     0    0     100000  menu,cheat,munchkin
cfg-munchkin-halfelf-mage 12345  1    1     100000  menu,cheat,munchkin
cfg-munchkin-dunadan-bg   1080   8    8     20000   menu,cheat,munchkin
# borg_lunal_mode = TRUE (does not by itself reach borg_think_dungeon_lunal,
# see docs/harness.md)
cfg-lunal-human-war       42     0    0     100000  menu,cheat,lunal
cfg-lunal-halfelf-mage    12345  1    1     100000  menu,cheat,lunal
cfg-lunal-dunadan-bg      1080   8    8     20000   menu,cheat,lunal
# lunal mode over a long game (not from the review): 1M turns, reaches
# max depth 27, deeper than any other suite. Self-lunal is not tried here:
# with borg_self_lunal = TRUE as well, no 1M run we tried passed its gate.
cfg-lunal-deep-warrior    2000   0    0     1000000 menu,cheat,lunal
