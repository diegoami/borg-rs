From 3e7fe8a8399352c4fe67f5de2d8d48b5e0bd04c1 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@soprasteria.com>
Date: Fri, 6 Nov 2026 22:09:21 +0100
Subject: [PATCH] Borg: always terminate the converted screen text

borg_what_text() converted the wide screen text with a byte limit of
one byte per wide character, although a multibyte character occupies
more: a line whose byte length lands exactly on the limit was
truncated without its terminating zero, and the caller's buffer -
uninitialized - was then trimmed and measured as a string, reading
stale stack bytes as phantom message text.  Bound the conversion by
the widest encoding for the same character count and fall back to an
empty string on a conversion error.

diff --git a/src/borg/borg-io.c b/src/borg/borg-io.c
index 5e608a3e0..db4a4ff92 100644
--- a/src/borg/borg-io.c
+++ b/src/borg/borg-io.c
@@ -122,8 +122,14 @@ errr borg_what_text(int x, int y, int n, uint8_t *a, char *s)
     /* Save the attribute */
     (*a) = d_a;
 
-    /* Convert back to a char string */
-    wcstombs(s, screen_str, ABS(n) + 1);
+    /* Convert back to a char string.  Each wide character can become
+     * several bytes, so a byte limit of one per wide character can
+     * truncate exactly at the limit and leave the destination
+     * unterminated; bound the conversion by the widest encoding
+     * instead, and fall back to an empty string on a conversion
+     * error. */
+    if (wcstombs(s, screen_str, ABS(n) * MB_CUR_MAX) == (size_t)-1)
+        s[0] = '\0';
     /* Too short */
     if ((n > 0) && (i != n))
         return 1;
