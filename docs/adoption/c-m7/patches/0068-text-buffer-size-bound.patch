From 60034c84c47e7ec71c25fbb637841ac018ef29bb Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@gmail.com>
Date: Sun, 8 Nov 2026 12:07:39 +0000
Subject: [PATCH] Borg: bound the converted screen text by the caller's buffer
 size

borg_what_text() converts the screen text into a caller buffer, but the
byte limit it gave wcstombs() was derived from the character count, not
from the size of that buffer.  A limit of one byte per character can
stop exactly at the limit without writing a terminator, and a limit of
MB_CUR_MAX bytes per character can exceed the buffer on a wide terminal
showing multibyte text.

Pass the destination size, convert at most size - 1 bytes and always
terminate the result (empty on a conversion error).  The callers pass
sizeof their buffers.

(cherry picked from commit e7f670fa4d4f0672dc346637fc7be20c814a4b62)
---
 src/borg/borg-io.c       | 20 +++++++++-----------
 src/borg/borg-io.h       |  3 ++-
 src/borg/borg-messages.c | 12 ++++++++----
 src/borg/borg-think.c    |  2 +-
 4 files changed, 20 insertions(+), 17 deletions(-)

diff --git a/src/borg/borg-io.c b/src/borg/borg-io.c
index db4a4ff92..a3b4b83dc 100644
--- a/src/borg/borg-io.c
+++ b/src/borg/borg-io.c
@@ -32,8 +32,9 @@ bool borg_confirm_target;
  * Query the "attr/chars" at a given location on the screen
  *
  * Note that "a" points to a single "attr", and "s" to an array
- * of "chars", into which the attribute and text at the given
- * location are stored.
+ * of "size" "chars", into which the attribute and text at the given
+ * location are stored.  The text is truncated to fit and always
+ * terminated.
  *
  * We will not grab more than "ABS(n)" characters for the string.
  * If "n" is "positive", we will grab exactly "n" chars, or fail.
@@ -51,9 +52,10 @@ bool borg_confirm_target;
  *
  * XXX XXX XXX We assume the given location is legal
  */
-errr borg_what_text(int x, int y, int n, uint8_t *a, char *s)
+errr borg_what_text(int x, int y, int n, uint8_t *a, char *s, size_t size)
 {
     int     i;
+    size_t  len;
     wchar_t screen_str[1024];
 
     int     t_a;
@@ -122,14 +124,10 @@ errr borg_what_text(int x, int y, int n, uint8_t *a, char *s)
     /* Save the attribute */
     (*a) = d_a;
 
-    /* Convert back to a char string.  Each wide character can become
-     * several bytes, so a byte limit of one per wide character can
-     * truncate exactly at the limit and leave the destination
-     * unterminated; bound the conversion by the widest encoding
-     * instead, and fall back to an empty string on a conversion
-     * error. */
-    if (wcstombs(s, screen_str, ABS(n) * MB_CUR_MAX) == (size_t)-1)
-        s[0] = '\0';
+    /* Convert back to a char string that fits the buffer; wcstombs()
+     * does not terminate a result it had to truncate */
+    len = wcstombs(s, screen_str, size - 1);
+    s[(len == (size_t)-1) ? 0 : len] = '\0';
     /* Too short */
     if ((n > 0) && (i != n))
         return 1;
diff --git a/src/borg/borg-io.h b/src/borg/borg-io.h
index b4f85cf15..f93e77031 100644
--- a/src/borg/borg-io.h
+++ b/src/borg/borg-io.h
@@ -40,7 +40,8 @@ extern bool borg_confirm_target;
 /*
  * Query the "attr/chars" at a given location on the screen
  */
-extern errr borg_what_text(int x, int y, int n, uint8_t *a, char *s);
+extern errr borg_what_text(
+    int x, int y, int n, uint8_t *a, char *s, size_t size);
 
 /*
  * Memorize a message, Log it, Search it, and Display it in pieces
diff --git a/src/borg/borg-messages.c b/src/borg/borg-messages.c
index 4f466f245..18de5c620 100644
--- a/src/borg/borg-messages.c
+++ b/src/borg/borg-messages.c
@@ -190,7 +190,8 @@ bool borg_get_messages(struct keypress* key, struct loc cursor)
 
     /* get everything on the message line */
     buf = buffer;
-    borg_what_text(0, 0, ((Term->wid - 1) / (tile_width)), &t_a, buffer);
+    borg_what_text(
+        0, 0, ((Term->wid - 1) / (tile_width)), &t_a, buffer, sizeof(buffer));
 #if 0
     /* just used for debugging.  Not so useful in general */
     if (borg_cfg[BORG_VERBOSE])
@@ -228,14 +229,16 @@ bool borg_get_messages(struct keypress* key, struct loc cursor)
     /* And that text is "-more-" */
     buf = buffer;
     if (borg_prompt && !inkey_flag && (cursor.y == 0) && (cursor.x >= 7)
-        && (0 == borg_what_text(cursor.x - 7, cursor.y, 7, &t_a, buffer))
+        && (0 == borg_what_text(
+            cursor.x - 7, cursor.y, 7, &t_a, buffer, sizeof(buffer)))
         && (suffix(buf, " -more-"))) {
 
         if (borg_cfg[BORG_VERBOSE])
             borg_note("# message with -more-");
 
         /* Get the message */
-        if (0 == borg_what_text(0, 0, cursor.x - 7, &t_a, buffer)) {
+        if (0 == borg_what_text(
+                0, 0, cursor.x - 7, &t_a, buffer, sizeof(buffer))) {
             /* Parse it */
             borg_parse(buf);
         }
@@ -271,7 +274,8 @@ bool borg_get_messages(struct keypress* key, struct loc cursor)
         buf = buffer;
         if (0
             == borg_what_text(
-                0, 0, ((Term->wid - 1) / (tile_width)), &t_a, buffer)) {
+                0, 0, ((Term->wid - 1) / (tile_width)), &t_a, buffer,
+                sizeof(buffer))) {
             int k = strlen(buf);
 
             /* Strip trailing spaces */
diff --git a/src/borg/borg-think.c b/src/borg/borg-think.c
index 030c5b87d..e0855be7c 100644
--- a/src/borg/borg-think.c
+++ b/src/borg/borg-think.c
@@ -219,7 +219,7 @@ bool borg_think(void)
     /*** Handle stores ***/
 
     /* Check for being in a store */
-    if ((0 == borg_what_text(1, 3, 4, &t_a, buf))
+    if ((0 == borg_what_text(1, 3, 4, &t_a, buf, sizeof(buf)))
         && (streq(buf, "Stor") || streq(buf, "Home")))
         return (borg_think_store());
 
