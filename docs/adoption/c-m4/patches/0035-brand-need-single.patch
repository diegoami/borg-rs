From 224c0d81f4aa37b4a54c868b1a248e092d280bf6 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@soprasteria.com>
Date: Fri, 6 Nov 2026 21:44:25 +0100
Subject: [PATCH] Borg: count the brand-ammo need once per stack

The brand-the-ammo test appeared twice in borg_notice_ammo(): once
inside the good-shooter block and once more after it, with the same
condition, so every qualifying stack added twenty to the
need-brand-weapon trait instead of ten.  Keep the copy that sits with
the enchant logic inside the block.
---
 src/borg/borg-trait.c | 15 ---------------
 1 file changed, 15 deletions(-)

diff --git a/src/borg/borg-trait.c b/src/borg/borg-trait.c
index ae2d118ca..993857d6e 100644
--- a/src/borg/borg-trait.c
+++ b/src/borg/borg-trait.c
@@ -1192,21 +1192,6 @@ static void borg_notice_ammo(int slot)
             }
         }
     } /* Ammo Power > 3 */
-
-    /* Only enchant ammo if we have a good shooter,
-     * otherwise, store the enchants in the home.
-     */
-    if (borg.trait[BI_AMMO_POWER] < 3)
-        return;
-
-    if ((borg_equips_item(act_firebrand, false)
-            || borg_spell_legal_fail(BRAND_AMMUNITION, 65))
-        && item->iqty >= 5 &&
-        /* Skip artifacts and ego-items */
-        !item->art_idx && !item->ego_idx && item->ident
-        && item->tval == borg.trait[BI_AMMO_TVAL]) {
-        borg.trait[BI_NEED_BRAND_WEAPON] += 10L;
-    }
 }
 
 /* don't give credit for perm-cursed non-artifacts */
-- 
