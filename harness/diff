#!/usr/bin/env python3
"""Compare Borg keypress logs and print the first divergence.

Usage:
  harness/diff [--suite NAME] [--expect-impl c|rust] [--allow-incomplete]
              [--allow-unverified] A B

  A and B are either two key logs (keys.log or keys.log.xz) or two
  directories of runs (each run is a subdirectory holding keys.log[.xz]
  and summary.json), e.g. a suite output dir and harness/reference/full.

Directory mode:
  * The runs compared are the union of the run names on both sides. A run
    present on one side only is a failure.
  * --suite NAME: both sides must hold exactly the runs listed in
    harness/suites/NAME, or in the suite file NAME if it contains a '/'
    (a missing or extra run is a failure).
  * Each run passes only if
      - the key logs are byte-identical,
      - on each side the key log has summary.keys lines and its last line's
        game turn equals summary.game_turns,
      - the two summary.json files are equal apart from wall_seconds.
  * A suite output dir (plain keys.log files) must hold the DONE marker
    that harness/suite.sh writes last; otherwise the diff refuses it
    (exit 2). --allow-incomplete turns that into a warning. Reference dirs
    (keys.log.xz only) need no marker.
  * Each side's build identity is printed from its manifest (written by
    harness/suite.sh): the binary's implementation, its BUILD_ID (git
    revision, dirty flags, source hash) and any overrides. A dir with
    plain key logs and no manifest, or a manifest without build identity
    (older suite.sh), is refused (exit 2). The diff fails (exit 1) if a
    manifest shows BORG_IMPL different from the binary's implementation,
    a recorded override (ALLOW_UNKNOWN_IMPL, ALLOW_STALE_BUILD), a binary
    changed during the suite, or, with --expect-impl c|rust, another
    implementation. --allow-unverified turns all of these into warnings.
    A dir with neither plain key logs nor a manifest is a reference (the
    C oracle) and is accepted as before.

For a key-log divergence it prints the run name, seed, game turn and key
index of the first differing line and 20 lines of context from each side.
Exit status: 0 if everything matches, 1 on any difference, 2 on bad input.
"""
import json
import lzma
import os
import sys

CONTEXT = 20
# summary.json fields that are not part of the oracle
IGNORED_FIELDS = {"wall_seconds"}
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def find_log(path):
    if os.path.isfile(path):
        return path
    if os.path.isfile(path + ".xz"):
        return path + ".xz"
    return None


def read_log(path):
    """Raw bytes of a key log (decompressed), or None."""
    p = find_log(path)
    if p is None:
        return None
    if p.endswith(".xz"):
        with lzma.open(p, "rb") as f:
            return f.read()
    with open(p, "rb") as f:
        return f.read()


def read_summary(run_dir):
    try:
        with open(os.path.join(run_dir, "summary.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def describe(line):
    parts = line.split()
    if len(parts) < 3:
        return line
    turn, typ, code = parts[0], parts[1], parts[2]
    try:
        c = int(code, 16)
    except ValueError:
        return line
    ch = chr(c) if 32 <= c < 127 else "0x%x" % c
    return "turn %s type %s key %s" % (turn, typ, ch)


def consistency(label, data, summary):
    """Problems between one side's key log and its summary.json."""
    probs = []
    if summary is None:
        return ["%s: no readable summary.json" % label]
    if data and not data.endswith(b"\n"):
        probs.append("%s: key log does not end with a newline" % label)
    lines = data.split(b"\n")
    if lines and lines[-1] == b"":
        lines.pop()
    keys = summary.get("keys")
    if keys != len(lines):
        probs.append("%s: key log has %d lines, summary keys=%s"
                     % (label, len(lines), keys))
    if lines:
        try:
            last_turn = int(lines[-1].split()[0])
        except (ValueError, IndexError):
            last_turn = None
        if last_turn != summary.get("game_turns"):
            probs.append("%s: last key at game turn %s, summary game_turns=%s"
                         % (label, last_turn, summary.get("game_turns")))
    return probs


def show_divergence(name, a, b, seed):
    la = a.decode("utf-8", "replace").split("\n")
    lb = b.decode("utf-8", "replace").split("\n")
    n = min(len(la), len(lb))
    i = 0
    while i < n and la[i] == lb[i]:
        i += 1
    if i < len(la) or i < len(lb):
        ref = la[i] if i < len(la) else lb[i]
    else:
        ref = ""
    turn = ref.split()[0] if ref.split() else "?"
    print("== %s: DIVERGES  seed=%s  game_turn=%s  key_index=%d"
          "  (bytes %d vs %d)" % (name, seed, turn, i, len(a), len(b)))
    if la[:n] == lb[:n] and len(la) == len(lb):
        # same lines, different bytes (e.g. line endings)
        print("   (same lines, different bytes)")
        return
    lo = max(0, i - CONTEXT)
    for label, lines in (("A", la), ("B", lb)):
        hi = min(len(lines), i + CONTEXT)
        print("--- %s lines %d..%d" % (label, lo, hi - 1))
        for j in range(lo, hi):
            mark = ">>" if j == i else "  "
            print("%s %7d  %-20s %s" % (mark, j, lines[j], describe(lines[j])))


def compare_run(name, da, db):
    """Compare one run (two run dirs). True if identical and consistent."""
    a = read_log(os.path.join(da, "keys.log"))
    b = read_log(os.path.join(db, "keys.log"))
    sa, sb = read_summary(da), read_summary(db)
    if a is None or b is None:
        print("== %s: missing key log (%s)" % (name, "A" if a is None else "B"))
        return False
    ok = True
    seed = (sa or {}).get("seed", (sb or {}).get("seed"))
    if a != b:
        show_divergence(name, a, b, seed)
        ok = False
    probs = consistency("A", a, sa) + consistency("B", b, sb)
    if sa is not None and sb is not None:
        keys = sorted(set(sa) | set(sb))
        for k in keys:
            if k in IGNORED_FIELDS:
                continue
            if sa.get(k, "<absent>") != sb.get(k, "<absent>"):
                probs.append("summary %s: A=%r B=%r"
                             % (k, sa.get(k, "<absent>"), sb.get(k, "<absent>")))
    if probs:
        print("== %s: %s" % (name, "; ".join(probs)))
        ok = False
    return ok


def suite_names(suite):
    path = suite if "/" in suite else os.path.join(ROOT, "harness", "suites", suite)
    names = []
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].split()
            if line:
                names.append(line[0])
    return names


def run_dirs(d):
    return set(x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x)))


def check_done(d, allow):
    """A suite output dir (plain keys.log) must carry DONE."""
    plain = any(os.path.isfile(os.path.join(d, r, "keys.log"))
                for r in run_dirs(d))
    if not plain or os.path.isfile(os.path.join(d, "DONE")):
        return True
    msg = "%s has no DONE marker (incomplete, failed or stale suite output)" % d
    if os.path.isfile(os.path.join(d, "FAILED")):
        msg = "%s is marked FAILED by harness/suite.sh" % d
    if allow:
        print("WARNING: " + msg)
        return True
    print("REFUSED: " + msg + "; use --allow-incomplete to compare anyway")
    return False


def read_manifest(path):
    m = {}
    with open(path) as f:
        for line in f:
            k, sep, v = line.rstrip("\n").partition("=")
            if sep and k not in m:
                m[k] = v
    return m


def check_manifest(label, d, expect_impl, allow):
    """Print a suite output dir's build identity and check it.

    Returns 0 if verified, 1 on a mismatch or a recorded override, 2 if
    the dir has no manifest of the current format. A dir without plain key
    logs is a reference (C oracle): 0, unless a manifest it keeps records a
    non-C build (2).
    """
    mpath = os.path.join(d, "manifest")
    plain = any(os.path.isfile(os.path.join(d, r, "keys.log"))
                for r in run_dirs(d))
    if not plain:
        # A reference (C oracle): compressed logs only. harness/reference/
        # classes also keeps the manifest of the C suite run that made it;
        # if present it must record a C build. References carry no build
        # identity (they predate it); they are checked by content.
        if not os.path.isfile(mpath):
            print("%s: %s: reference (no manifest)" % (label, d))
            return 0
        m = read_manifest(mpath)
        impls = {m.get(k) for k in ("borg_impl_env", "binary_cmake_borg_impl",
                                    "binary_impl") if m.get(k)}
        if impls - {"c"}:
            print("REFUSED: %s: reference manifest records a non-C build (%s)"
                  % (d, ", ".join(sorted(impls))))
            return 2
        print("%s: %s: reference (manifest of its C run: impl=c, rev %s)"
              % (label, d, m.get("git_rev", "?")[:12]))
        return 0
    if not os.path.isfile(mpath):
        msg = "%s has no manifest (not written by harness/suite.sh)" % d
        if allow:
            print("WARNING: " + msg)
            return 0
        print("REFUSED: " + msg + "; use --allow-unverified to compare anyway")
        return 2
    m = read_manifest(mpath)
    g = lambda k: m.get(k, "?")
    print("%s: %s: impl=%s (BORG_IMPL=%s; executable %s, CMakeCache %s, "
          "BUILD_ID %s) binary_sha256=%s" % (
              label, d, g("binary_impl"), g("borg_impl_env"),
              g("binary_elf_impl"), g("binary_cmake_borg_impl"),
              g("build_id_impl"), g("binary_sha256")[:16]))
    print("%s:   built from %s (dirty=%s, inputs dirty=%s) source_sha256=%s;"
          " run at %s (dirty=%s) overrides=%s" % (
              label, g("build_id_git_rev")[:12], g("build_id_git_dirty"),
              g("build_id_inputs_dirty"), g("build_id_source_sha256")[:16],
              g("git_rev")[:12], g("git_dirty"), g("overrides")))
    if "overrides" not in m or "binary_impl" not in m:
        msg = ("%s: manifest has no build identity (written by an older "
               "harness/suite.sh)" % d)
        if allow:
            print("WARNING: " + msg)
            return 0
        print("REFUSED: " + msg + "; use --allow-unverified to compare anyway")
        return 2
    probs = []
    env, impl = m.get("borg_impl_env"), m.get("binary_impl")
    if env != impl:
        probs.append("implementation mismatch: BORG_IMPL=%s, binary %s"
                     % (env, impl))
    if expect_impl is not None and (env != expect_impl or impl != expect_impl):
        probs.append("expected implementation %s, manifest says BORG_IMPL=%s,"
                     " binary %s" % (expect_impl, env, impl))
    if m.get("overrides") != "none":
        probs.append("suite ran with override(s) %s" % m.get("overrides"))
    for k in ("impl_check", "build_check"):
        if m.get(k) != "ok":
            probs.append("%s: %s" % (k, m.get(k)))
    if m.get("binary_sha256_end", m.get("binary_sha256")) != m.get("binary_sha256"):
        probs.append("binary changed while the suite ran")
    if not probs:
        return 0
    for p in probs:
        print("%s %s: %s" % ("WARNING:" if allow else "UNVERIFIED:", label, p))
    return 0 if allow else 1


def main(argv):
    args = argv[1:]
    suite = None
    allow = False
    allow_unverified = False
    expect_impl = None
    while args and args[0].startswith("--"):
        opt = args.pop(0)
        if opt == "--suite" and args:
            suite = args.pop(0)
        elif opt == "--allow-incomplete":
            allow = True
        elif opt == "--allow-unverified":
            allow_unverified = True
        elif opt == "--expect-impl" and args and args[0] in ("c", "rust"):
            expect_impl = args.pop(0)
        else:
            print(__doc__)
            return 2
    if len(args) != 2:
        print(__doc__)
        return 2
    A, B = args
    if os.path.isdir(A) and os.path.isdir(B):
        if not (check_done(A, allow) & check_done(B, allow)):
            return 2
        mrc = [check_manifest(label, d, expect_impl, allow_unverified)
               for label, d in (("A", A), ("B", B))]
        if 2 in mrc:
            return 2
        unverified = 1 in mrc
        na, nb = run_dirs(A), run_dirs(B)
        ok = True
        if suite is not None:
            expected = suite_names(suite)
            if len(set(expected)) != len(expected):
                print("suite %s lists a run name twice" % suite)
                return 2
            for label, d, have in (("A", A, na), ("B", B, nb)):
                missing = sorted(set(expected) - have)
                extra = sorted(have - set(expected))
                for r in missing:
                    print("== %s: MISSING in %s (%s)" % (r, label, d))
                for r in extra:
                    print("== %s: not in suite %s, present in %s (%s)"
                          % (r, suite, label, d))
                ok &= not missing and not extra
            names = sorted(set(expected) | na | nb)
        else:
            names = sorted(na | nb)
            expected = names
        if not names:
            print("no runs in %s or %s" % (A, B))
            return 2
        same = 0
        for d in names:
            if d not in na or d not in nb:
                if suite is None:
                    print("== %s: only in %s" % (d, "A" if d in na else "B"))
                ok = False
                continue
            r = compare_run(d, os.path.join(A, d), os.path.join(B, d))
            same += r
            ok &= r
        print("%d/%d runs identical (expected %d)"
              % (same, len(names), len(expected)))
        if same != len(expected):
            ok = False
        if unverified:
            print("FAIL: build identity not verified (see UNVERIFIED above);"
                  " --allow-unverified to ignore")
            ok = False
    else:
        a, b = read_log(A), read_log(B)
        if a is None or b is None:
            print("missing log (%s)" % ("A" if a is None else "B"))
            return 1
        ok = a == b
        if not ok:
            s = read_summary(os.path.dirname(A)) or {}
            show_divergence(os.path.basename(A), a, b, s.get("seed"))
        else:
            print("identical")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
