+        finish_txt_settings(&mut env, found, old);
+        borg_munchkin_class_settings(&mut env.st, Some(1));
+        let c = &env.st.core.cfg;
+        assert_eq!((c[BORG_MUNCHKIN_START as usize], c[BORG_MUNCHKIN_DEPTH as usize]), (0, 16));
+    }
