+
+#[cfg(test)]
+mod review_forecast_probe {
+    use super::*;
+    use crate::borg_headers::borg_trait_h::{BI_MAX, BI_MAXDEPTH, BI_CLEVEL, BI_MAXHP};
+    use crate::borg_headers::borg_h::{BORG_TOWN_PLAN, BORG_TOWN_TARGET_DEPTH, BORG_TRIP_POLICY};
+    #[test]
+    fn review_automatic_trip_forecast_must_agree_with_throwing_forecast() {
+        let mut st = BorgState::default();
+        st.core.cfg = crate::borg_init::BORG_SETTINGS.iter().map(|s| s.default_value).collect();
+        st.core.cfg[BORG_TOWN_PLAN as usize] = 1;
+        st.core.cfg[BORG_TRIP_POLICY as usize] = 1;
+        st.borg.trait_ = vec![0; BI_MAX as usize];
+        st.borg.trait_[BI_MAXDEPTH as usize] = 1;
+        st.borg.trait_[BI_CLEVEL as usize] = 10;
+        st.borg.trait_[BI_MAXHP as usize] = 100;
+        let inputs = crate::borg_trip::TripInputs { prepared_depth: 12, max_depth: 1, ..Default::default() };
+        let forecast = crate::borg_trip::plan_trip(&inputs, &crate::borg_trip::TripParams::of(&st.core.cfg));
+        let mut params = [0; PARAMS];
+        for (i, value) in params.iter_mut().enumerate() { *value = i64::from(st.cfg(BORG_TOWN_PLAN + i as u32)); }
+        let params = effective_params(params, Some(forecast));
+        let throwing = crate::borg_town_utility::Journey::of(&st);
+        st.core.cfg[BORG_TOWN_TARGET_DEPTH as usize] = params[(BORG_TOWN_TARGET_DEPTH - BORG_TOWN_PLAN) as usize] as i32;
+        let town = crate::borg_town_utility::Journey::of(&st);
+        let reserve = |turns: i64| ((turns - 5000).max(0) as u64).div_ceil(7500);
+        assert_eq!((throwing.turns, reserve(throwing.turns)), (town.turns, reserve(town.turns)),
+            "town values fuel for the shared trip; the throwing guard must reserve it for that same trip");
+    }
+}
