From 2260c791fb1747afaecfbc0a3663e7f9fcaabbf1 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@gmail.com>
Date: Mon, 9 Nov 2026 01:25:03 +0000
Subject: [PATCH] Borg: let a Borg with no food buy Remove Hunger at the
 Alchemist

When the Borg carries no food, borg_think_shop_buy_useful() only
weighs the General Store and the Home, and a starving check lets
food and Scrolls of Remove Hunger through.  Remove Hunger is only
sold by the Alchemist, which that store filter skipped, and the check
was written as tval != scroll && sval != Remove Hunger, so it let any
scroll (or any item with Remove Hunger's sval) through instead of
only that scroll.  The Borg also never counted the scrolls as food, so
buying one never raised its power and it was never chosen.

So a Borg with no food in town, with gold, and with no food left in
the General Store chose no shop at all, although the Alchemist had
Remove Hunger for sale.

Admit the Alchemist (store 4) in the store filter when the Borg has
no food, write the starving check as "food, or a Scroll of Remove
Hunger", and count Remove Hunger scrolls as food only when the Borg
has no other food.  A Borg that carries food is unaffected.

Tracked as diegoami/neo-angband-tracker#18.

(cherry picked from commit 0fd9bc4bd6f069e0cbab664e7541e3202764a9a4)
---
 src/borg/borg-store-buy.c | 9 ++++-----
 src/borg/borg-trait.c     | 7 +++++++
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/borg/borg-store-buy.c b/src/borg/borg-store-buy.c
index eb1be2b61..bd0c7a2be 100644
--- a/src/borg/borg-store-buy.c
+++ b/src/borg/borg-store-buy.c
@@ -249,7 +249,7 @@ bool borg_think_shop_buy_useful(void)
 
         /* If I am bad shape up, only see certain stores */
         if ((borg.trait[BI_LIGHT] == 0 || borg.trait[BI_FOOD] == 0) && k != 0
-            && k != BORG_HOME)
+            && k != BORG_HOME && !(borg.trait[BI_FOOD] == 0 && k == 4))
             continue;
         /* Cures for poison and cuts are sold in the Alchemy shop */
         if ((borg.trait[BI_ISCUT] || borg.trait[BI_ISPOISONED]) && k != 4)
@@ -280,10 +280,9 @@ bool borg_think_shop_buy_useful(void)
             /* Skip it if I just sold this item. XXX XXX*/
 
             /* Special check for 'immediate shopping' */
-            if (borg.trait[BI_FOOD] == 0
-                && (item->tval != TV_FOOD
-                    && (item->tval != TV_SCROLL
-                        && item->sval != sv_scroll_satisfy_hunger)))
+            if (borg.trait[BI_FOOD] == 0 && item->tval != TV_FOOD
+                && !(item->tval == TV_SCROLL
+                    && item->sval == sv_scroll_satisfy_hunger))
                 continue;
 
             /* Don't fill up on attack wands, its ok to buy a few */
diff --git a/src/borg/borg-trait.c b/src/borg/borg-trait.c
index 993857d6e..48ffab3a2 100644
--- a/src/borg/borg-trait.c
+++ b/src/borg/borg-trait.c
@@ -2176,6 +2176,7 @@ static void borg_notice_equipment(void)
 static void borg_notice_inventory(void)
 {
     int i;
+    int remove_hunger = 0;
 
     borg_item *item;
 
@@ -2364,6 +2365,8 @@ static void borg_notice_inventory(void)
 
             if (item->sval == sv_scroll_identify)
                 borg.trait[BI_AID] += item->iqty;
+            else if (item->sval == sv_scroll_satisfy_hunger)
+                remove_hunger += item->iqty;
             else if (item->sval == sv_scroll_recharging)
                 borg.trait[BI_ARECHARGE] += item->iqty;
             else if (item->sval == sv_scroll_phase_door)
@@ -2805,6 +2808,10 @@ static void borg_notice_inventory(void)
     borg.trait[BI_FOOD] += borg.trait[BI_FOOD_HI];
     borg.trait[BI_FOOD] += borg.trait[BI_FOOD_LO];
 
+    /* With no other food, Remove Hunger scrolls are the food supply */
+    if (borg.trait[BI_FOOD] == 0)
+        borg.trait[BI_FOOD] = remove_hunger;
+
     /* If weak, do not count food spells */
     if (borg.trait[BI_ISWEAK] && (borg.trait[BI_FOOD] >= 1000))
         borg.trait[BI_FOOD] -= 1000;
-- 
