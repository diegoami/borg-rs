From 9ab78ae605ca4463268a669121d69b216285c2f1 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@soprasteria.com>
Date: Fri, 6 Nov 2026 19:46:50 +0100
Subject: [PATCH] Borg: accumulate weapon slay traits across equipment slots

The slay traits were assigned, not or-ed, for every equipment slot in
borg_notice_equipment(), so the last occupied slot - usually the light
or boots, which carry no slays - erased whatever the wielded weapon
provided, and every melee valuation saw an unslaying weapon.  Accumulate
them across slots instead.  Also derive the never-set kill traits from
the same race flags, where the race-destroying slays are stored with the
largest multiplier.

diff --git a/src/borg/borg-trait.c b/src/borg/borg-trait.c
index 154eb3849..b9f48b3c4 100644
--- a/src/borg/borg-trait.c
+++ b/src/borg/borg-trait.c
@@ -1444,15 +1444,26 @@ static void borg_notice_equipment(void)
         borg.trait[BI_ACON] += item->modifiers[OBJ_MOD_CON]
                                * player->obj_k->modifiers[OBJ_MOD_CON];
 
-        /* various slays */
-        borg.trait[BI_WS_ANIMAL] = item->slays[RF_ANIMAL];
-        borg.trait[BI_WS_EVIL]   = item->slays[RF_EVIL];
-        borg.trait[BI_WS_UNDEAD] = item->slays[RF_UNDEAD];
-        borg.trait[BI_WS_DEMON]  = item->slays[RF_DEMON];
-        borg.trait[BI_WS_ORC]    = item->slays[RF_ORC];
-        borg.trait[BI_WS_TROLL]  = item->slays[RF_TROLL];
-        borg.trait[BI_WS_GIANT]  = item->slays[RF_GIANT];
-        borg.trait[BI_WS_DRAGON] = item->slays[RF_DRAGON];
+        /* various slays: accumulate across slots.  Assigning them per
+         * slot made the last occupied slot (usually the light or boots,
+         * with no slays) erase the wielded weapon's slays. */
+        borg.trait[BI_WS_ANIMAL] |= item->slays[RF_ANIMAL];
+        borg.trait[BI_WS_EVIL]   |= item->slays[RF_EVIL];
+        borg.trait[BI_WS_UNDEAD] |= item->slays[RF_UNDEAD];
+        borg.trait[BI_WS_DEMON]  |= item->slays[RF_DEMON];
+        borg.trait[BI_WS_ORC]    |= item->slays[RF_ORC];
+        borg.trait[BI_WS_TROLL]  |= item->slays[RF_TROLL];
+        borg.trait[BI_WS_GIANT]  |= item->slays[RF_GIANT];
+        borg.trait[BI_WS_DRAGON] |= item->slays[RF_DRAGON];
+
+        /* the greater, race-destroying slays are stored under the same
+         * race flag with the largest multiplier */
+        if (item->slays[RF_UNDEAD] >= 5)
+            borg.trait[BI_WK_UNDEAD] = true;
+        if (item->slays[RF_DEMON] >= 5)
+            borg.trait[BI_WK_DEMON] = true;
+        if (item->slays[RF_DRAGON] >= 5)
+            borg.trait[BI_WK_DRAGON] = true;
 
         /* various brands */
         if (item->brands[ELEM_ACID])
